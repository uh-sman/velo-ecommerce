# Velo Commerce — environment template.
# Copy to .env and fill in. Every variable without a default is required:
# the API fails fast at startup rather than discovering the gap under load.

# ─── Core ──────────────────────────────────────────────────────────────────
VELO_ENV=development                 # development | staging | production
VELO_DEBUG=true                      # never true outside development
VELO_SECRET_KEY=change-me-32-chars-minimum-for-local-development-only

# ─── Database ──────────────────────────────────────────────────────────────
VELO_DATABASE_URL=postgresql+asyncpg://velo:velo@localhost:5432/velo
VELO_DATABASE_POOL_SIZE=10
VELO_DATABASE_MAX_OVERFLOW=5

# ─── Redis ─────────────────────────────────────────────────────────────────
VELO_REDIS_URL=redis://localhost:6379/0

# ─── Search ────────────────────────────────────────────────────────────────
VELO_MEILISEARCH_URL=http://localhost:7700
VELO_MEILISEARCH_MASTER_KEY=local-dev-master-key

# ─── Auth (ADR-008) ────────────────────────────────────────────────────────
VELO_ACCESS_TOKEN_TTL_SECONDS=900        # 15 minutes
VELO_REFRESH_TOKEN_TTL_SECONDS=2592000   # 30 days
VELO_COOKIE_DOMAIN=localhost
VELO_COOKIE_SECURE=false                 # true everywhere but local HTTP

# ─── CORS ──────────────────────────────────────────────────────────────────
VELO_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Payments (ADR-006) — Phase 8 ──────────────────────────────────────────
# Test keys only in development. A live key in a .env file is an incident.
VELO_STRIPE_SECRET_KEY=
VELO_STRIPE_WEBHOOK_SECRET=

# ─── Email — Phase 12 ──────────────────────────────────────────────────────
VELO_SMTP_HOST=localhost
VELO_SMTP_PORT=1025                  # MailHog in docker-compose.dev.yml
VELO_EMAIL_FROM=orders@velo.example

# ─── Frontend (Next.js) ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
