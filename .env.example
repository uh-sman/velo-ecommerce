# Velo Commerce — environment template.
# Copy to .env and fill in. Every variable without a default is required:
# the API fails fast at startup rather than discovering the gap under load.

# ─── Core ──────────────────────────────────────────────────────────────────
VELO_ENV=development                 # development | staging | production
VELO_DEBUG=true                      # never true outside development
VELO_SECRET_KEY=change-me-32-chars-minimum-for-local-development-only

# ─── Database ──────────────────────────────────────────────────────────────
VELO_DATABASE_URL=postgresql+asyncpg://velo:velo@localhost:5432/velo
VELO_DATABASE_POOL_SIZE=10
VELO_DATABASE_MAX_OVERFLOW=5

# ─── Redis ─────────────────────────────────────────────────────────────────
VELO_REDIS_URL=redis://localhost:6379/0

# ─── Search ────────────────────────────────────────────────────────────────
# 127.0.0.1, not localhost: on Docker Desktop for Windows, localhost resolves to
# IPv6 ::1 first and the IPv6 port relay adds ~45 ms to every HTTP round trip.
VELO_MEILISEARCH_URL=http://127.0.0.1:7700
VELO_MEILISEARCH_MASTER_KEY=local-dev-master-key

# ─── Auth (ADR-008) ────────────────────────────────────────────────────────
VELO_ACCESS_TOKEN_TTL_SECONDS=900        # 15 minutes
VELO_REFRESH_TOKEN_TTL_SECONDS=2592000   # 30 days
VELO_COOKIE_DOMAIN=localhost
VELO_COOKIE_SECURE=false                 # true everywhere but local HTTP

# ─── CORS ──────────────────────────────────────────────────────────────────
VELO_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Payments (ADR-006) — Phase 8 ──────────────────────────────────────────
# Test keys only in development. A live key in a .env file is an incident.
# Unset: checkout works up to payment, which answers 503 "payments unavailable".
# Local webhooks: `stripe listen --forward-to localhost:8000/api/v1/webhooks/stripe`
# prints the whsec_ signing secret to put here.
VELO_STRIPE_SECRET_KEY=
VELO_STRIPE_PUBLISHABLE_KEY=
VELO_STRIPE_WEBHOOK_SECRET=
# Paystack (NGN, GHS, ZAR, KES by default). The secret key also signs its webhooks.
VELO_PAYSTACK_SECRET_KEY=
VELO_PAYSTACK_PUBLIC_KEY=
# Which provider takes which currency; anything unlisted goes to the default.
# VELO_PAYMENT_DEFAULT_PROVIDER=stripe
# VELO_PAYMENT_CURRENCY_PROVIDERS=NGN:paystack,GHS:paystack,ZAR:paystack,KES:paystack
# How long a checkout holds its stock, in minutes.
# VELO_CHECKOUT_TTL_MINUTES=30

# ─── Orders, fulfilment and returns — Phase 9 ──────────────────────────────
# VELO_STORE_NAME=Velo
# Printed on return labels; "|" separates the lines.
# VELO_RETURN_ADDRESS=Velo Returns|1 Warehouse Way|San Francisco, CA 94103|US
# VELO_RETURN_WINDOW_DAYS=30
# Carrier tracking webhooks: HMAC-SHA256 of the raw body in X-Velo-Signature.
# Empty turns POST /webhooks/tracking off.
VELO_TRACKING_WEBHOOK_SECRET=

# ─── Email — Phase 12 ──────────────────────────────────────────────────────
VELO_SMTP_HOST=localhost
VELO_SMTP_PORT=1025                  # MailHog; 1026 if VELO_MAILHOG_SMTP_PORT=1026
VELO_EMAIL_FROM=orders@velo.example

# ─── Media storage (Phase 6) — MinIO in docker-compose.dev.yml ─────────────
VELO_S3_ENDPOINT_URL=http://127.0.0.1:9000
VELO_S3_REGION=us-east-1
VELO_S3_BUCKET=velo-media
VELO_S3_ACCESS_KEY_ID=velo
VELO_S3_SECRET_ACCESS_KEY=velo-dev-secret
VELO_MEDIA_PUBLIC_URL=http://127.0.0.1:9000/velo-media

# ─── Catalog alerts ────────────────────────────────────────────────────────
VELO_OPS_ALERT_EMAIL=ops@velo.example    # low-stock alerts; MailHog catches it

# ─── Frontend (Next.js) ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
