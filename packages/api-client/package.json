{
  "name": "@velo/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "uv run --project ../../apps/api python ../../apps/api/scripts/export_openapi.py ../../apps/api/openapi.json && pnpm generate:ci",
    "generate:ci": "openapi-typescript ../../apps/api/openapi.json -o ./src/schema.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.8.0",
    "@velo/config": "workspace:*",
    "eslint": "^9.13.0",
    "openapi-typescript": "^7.4.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
